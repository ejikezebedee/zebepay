# Zebepay example environment.
# Copy to .env for local development.

NODE_ENV=development
APP_NAME=Zebepay
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

DATABASE_URL=postgresql://zebepay_user@localhost:5432/zebepay
ZEBEPAY_STORAGE_MODE=memory
ZEBEPAY_PERSISTENCE_CRITICAL_WRITES=disabled
ZEBEPAY_POSTGRES_TRANSFER_WRITES=disabled
ZEBEPAY_POSTGRES_ADMIN_WRITES=disabled
ZEBEPAY_POSTGRES_AUTH_SESSION=disabled
ZEBEPAY_POSTGRES_AUDIT_WRITES=disabled
ZEBEPAY_MIGRATIONS_CONFIRMED=false
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ZEBEPAY_SANDBOX_SESSION_SECRET=change-me-sandbox-session-secret
ENCRYPTION_KEY=change-me-32-byte-key

SANDBOX_PROVIDER_ENABLED=true
